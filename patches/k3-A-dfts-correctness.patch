+/* dft768 has a single-transform layout; the PUSCH path packs four lanes. */
+static void dft768_packed4(const int16_t *x, int16_t *y)
+{
+  int16_t lane_input[768 * 2] __attribute__((aligned(32)));
+  int16_t lane_output[768 * 2] __attribute__((aligned(32)));
+  for (int lane = 0; lane < 4; ++lane) {
+    for (int k = 0; k < 768; ++k) {
+      lane_input[2*k] = x[8*k + 2*lane];
+      lane_input[2*k+1] = x[8*k + 2*lane+1];
+    }
+    dft768(lane_input, lane_output, 1);
+    for (int k = 0; k < 768; ++k) {
+      y[8*k + 2*lane] = lane_output[2*k];
+      y[8*k + 2*lane+1] = lane_output[2*k+1];
+    }
+  }
+}
