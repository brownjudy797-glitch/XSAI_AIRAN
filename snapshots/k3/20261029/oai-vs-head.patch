+    merge_meas(&dst->bn2cnProcBuf,   &src->bn2cnProcBuf);
+    merge_meas(&dst->llrRes2llrOut,  &src->llrRes2llrOut);
+    merge_meas(&dst->llr2bit,        &src->llr2bit);
